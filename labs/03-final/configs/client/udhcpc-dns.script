#!/bin/sh
# Script udhcpc des clients : applique la configuration DHCP (adresse, route)
# via le script d'origine, puis écrit les serveurs DNS reçus dans /etc/resolv.conf
# (Docker gère ce fichier et udhcpc ne le modifie pas par défaut).
ORIG=/usr/share/udhcpc/default.script
[ -x "$ORIG" ] && "$ORIG" "$@"

case "$1" in
  bound|renew)
    if [ -n "$dns" ]; then
      : > /etc/resolv.conf
      for d in $dns; do
        echo "nameserver $d" >> /etc/resolv.conf
      done
      s="${search:-$domain}"
      [ -n "$s" ] && echo "search $s" >> /etc/resolv.conf
    fi
    ;;
esac
exit 0
